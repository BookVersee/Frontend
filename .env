
# =============================================================================
# BOOKVERSE MULTI-VENDOR MARKETPLACE - LOCAL ENVIRONMENT CONFIGURATION (.env)
# =============================================================================
# File này chứa các thiết lập cấu hình thực tế cho máy local và Docker Compose.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CỔNG MẠNG & DOCKER COMPOSE
# -----------------------------------------------------------------------------
PORT_FRONTEND=5173
PORT_BACKEND=5226
PORT_DB=1433

# -----------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU (SQL SERVER LOCAL / DOCKER)
# -----------------------------------------------------------------------------
DB_TYPE=sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_NAME=BookManagementDb
DB_USER=sa
DB_PASSWORD=EduSphere@2026StrongPass!
DB_CONNECTION_STRING=Server=localhost,1433;Database=BookManagementDb;User Id=sa;Password=EduSphere@2026StrongPass!;TrustServerCertificate=True;

# -----------------------------------------------------------------------------
# 3. CẤU HÌNH HỆ THỐNG BACKEND & BẢO MẬT CORE (.NET 8 WEB API)
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
BACKEND_URL=http://localhost:5226
JWT_SECRET_KEY=SuperSecretKeyForBookManagementProjectThatIsVeryLongAndSecure123!
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# 4. CẤU HÌNH FRONTEND (VITE & CLIENT RUNTIME)
# -----------------------------------------------------------------------------
VITE_APP_ENV=development
VITE_APP_TITLE=BookVerse Multi-Vendor Marketplace
VITE_PORT=5173

VITE_API_URL=/api
VITE_API_TIMEOUT=15000

VITE_BACKEND_URL=http://localhost:5226
VITE_WS_CHAT_URL=/hubs/chat
VITE_WS_NOTIF_URL=/hubs/notifications
VITE_WS_APP_URL=/hubs/app

VITE_ENABLE_MOCK=false
VITE_ENABLE_AI_ASSISTANT=true

# -----------------------------------------------------------------------------
# 5. CỔNG THANH TOÁN TRỰC TUYẾN (SANDBOX)
# -----------------------------------------------------------------------------
VITE_VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VITE_VNPAY_TMN_CODE=BOOKVERSE01

VITE_MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
VITE_MOMO_PARTNER_CODE=MOMO_BOOKVERSE

# -----------------------------------------------------------------------------
# 6. ĐƠN VỊ VẬN CHUYỂN (GHN EXPRESS)
# -----------------------------------------------------------------------------
VITE_GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
VITE_GHN_SHOP_ID=190000

# -----------------------------------------------------------------------------
# 7. LƯU TRỮ ẢNH & GOOGLE OAUTH
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=bookverse-dev
VITE_CLOUDINARY_UPLOAD_PRESET=bookverse_preset
VITE_GOOGLE_CLIENT_ID=1051892403102-kf5dfigq8bcf4n9uv17411751090kqr5.apps.googleusercontent.com
