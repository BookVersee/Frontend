# =============================================================================
# BOOKVERSE MULTI-VENDOR MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Sao chép tệp tin này thành `.env.development` hoặc `.env.production` và điền giá trị.

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH MÁY CHỦ BACKEND & GIAO TIẾP MẠNG (CORE BACKEND API)
# -----------------------------------------------------------------------------
# Địa chỉ gốc Backend API (.NET 8 Web API / Node.js)
# Trong môi trường Dev, dùng '/api' để đi qua Vite Reverse Proxy tránh lỗi CORS
VITE_API_URL=/api
# Thời gian timeout tối đa cho mỗi HTTP request (tính bằng milliseconds, mặc định 15000ms = 15s)
VITE_API_TIMEOUT=15000
# Địa chỉ kết nối WebSocket / SignalR Hub cho tính năng Chat và Thông báo Real-time
VITE_WS_CHAT_URL=ws://localhost:5000/hubs/chat

# -----------------------------------------------------------------------------
# 2. CỔNG THANH TOÁN TRỰC TUYẾN (PAYMENT GATEWAYS)
# -----------------------------------------------------------------------------
# Cổng thanh toán VNPAY (Môi trường thử nghiệm Sandbox)
VITE_VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VITE_VNPAY_TMN_CODE=BOOKVERSE01

# Cổng thanh toán Ví điện tử MoMo (Môi trường Test Sandbox)
VITE_MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
VITE_MOMO_PARTNER_CODE=MOMO_BOOKVERSE

# -----------------------------------------------------------------------------
# 3. ĐƠN VỊ VẬN CHUYỂN & LOGISTICS (GIAO HÀNG NHANH - GHN EXPRESS)
# -----------------------------------------------------------------------------
# Địa chỉ API tính phí giao hàng và tạo vận đơn GHN Express
VITE_GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
VITE_GHN_SHOP_ID=190000
VITE_GHN_TOKEN=ghn-dev-token-example

# -----------------------------------------------------------------------------
# 4. LƯU TRỮ HÌNH ẢNH & BẰNG CHỨNG KHIẾU NẠI (CLOUDINARY / S3)
# -----------------------------------------------------------------------------
# Cấu hình tải ảnh bìa sách và ảnh lỗi sản phẩm trực tiếp từ trình duyệt
VITE_CLOUDINARY_CLOUD_NAME=bookverse-cloud
VITE_CLOUDINARY_UPLOAD_PRESET=bookverse_books_preset

# -----------------------------------------------------------------------------
# 5. CẤU HÌNH ỨNG DỤNG & CỜ TÍNH NĂNG (APP ENVIRONMENT & FEATURE FLAGS)
# -----------------------------------------------------------------------------
# Môi trường chạy ứng dụng: 'development' | 'staging' | 'production'
VITE_APP_ENV=development
# Tiêu đề hiển thị trên thanh tiêu đề trình duyệt
VITE_APP_TITLE=BookVerse - Sàn Sách Trực Tuyến Đa Cửa Hàng
# Cho phép tự động chuyển sang dữ liệu mẫu Mock khi Backend chưa khởi chạy
VITE_ENABLE_MOCK=true
# Bật/Tắt tính năng Trợ lý AI tư vấn và gợi ý sách (AI Book Assistant)
VITE_ENABLE_AI_ASSISTANT=true

# -----------------------------------------------------------------------------
# 6. XÁC THỰC GOOGLE OAUTH (GOOGLE SIGN-IN / SSO)
# -----------------------------------------------------------------------------
# Google Client ID từ Google Cloud Console (OAuth 2.0 Client Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
