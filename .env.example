# =============================================================================
# BOOKVERSE MULTI-VENDOR MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Sao chép tệp tin này thành `.env`:
#      cp .env.example .env
# 2. Cập nhật các giá trị cấu hình thực tế cho máy của bạn hoặc Docker Compose.
# 3. KHÔNG commit file `.env` lên Git để đảm bảo an toàn bảo mật.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CỔNG MẠNG & DOCKER COMPOSE (PORTS & CONTAINER NETWORKING)
# -----------------------------------------------------------------------------
# Cổng ứng dụng Frontend (React + Vite)
PORT_FRONTEND=5173
# Cổng ứng dụng Backend (.NET 8 Web API)
PORT_BACKEND=5226
# Cổng cơ sở dữ liệu (1433 cho SQL Server, 5432 nếu sử dụng PostgreSQL)
PORT_DB=1433

# -----------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU (DATABASE CONNECTION - SQL SERVER / POSTGRESQL)
# -----------------------------------------------------------------------------
# Loại CSDL: 'sqlserver' | 'postgres'
DB_TYPE=sqlserver
# Host CSDL: 'localhost' khi chạy trực tiếp máy host, hoặc tên service 'db' trong Docker Compose
DB_HOST=localhost
DB_PORT=1433
DB_NAME=BookManagementDb
DB_USER=sa
# Mật khẩu quản trị CSDL (yêu cầu mật khẩu mạnh gồm chữ hoa, thường, số, ký tự đặc biệt)
DB_PASSWORD=YourStrongPasswordHere123!
# Chuỗi kết nối hoàn chỉnh (được Docker Compose hoặc Backend nạp trực tiếp)
# - Định dạng SQL Server: Server=db,1433;Database=BookManagementDb;User Id=sa;Password=YourStrongPasswordHere123!;TrustServerCertificate=True;
# - Định dạng PostgreSQL: Host=db;Port=5432;Database=BookManagementDb;Username=postgres;Password=YourStrongPasswordHere123!;
DB_CONNECTION_STRING=Server=localhost,1433;Database=BookManagementDb;User Id=sa;Password=YourStrongPasswordHere123!;TrustServerCertificate=True;

# -----------------------------------------------------------------------------
# 3. CẤU HÌNH HỆ THỐNG BACKEND & BẢO MẬT CORE (.NET 8 WEB API)
# -----------------------------------------------------------------------------
# Môi trường chạy Backend: 'Development' | 'Staging' | 'Production'
ASPNETCORE_ENVIRONMENT=Development
# Domain API Backend gốc
BACKEND_URL=http://localhost:5226
# Khóa bí mật mã hóa JWT Token (Tối thiểu 32 ký tự)
JWT_SECRET_KEY=YourSuperSecretKeyForJwtAuthenticationMustBeLongAndSecure123!
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# 4. CẤU HÌNH FRONTEND (VITE & CLIENT RUNTIME - BẮT ĐẦU BẰNG VITE_)
# Lưu ý: Chỉ các biến có tiền tố VITE_ mới được đưa vào mã nguồn chạy ở trình duyệt
# -----------------------------------------------------------------------------
# Môi trường ứng dụng: 'development' | 'staging' | 'production'
VITE_APP_ENV=development
# Tiêu đề hiển thị trên thanh tab trình duyệt
VITE_APP_TITLE=BookVerse - Sàn Thương Mại Điện Tử Sách
# Cổng chạy Vite dev server
VITE_PORT=5173

# Đường dẫn gọi API: Dùng '/api' khi chạy qua Vite Reverse Proxy để tránh lỗi CORS
VITE_API_URL=/api
# Thời gian timeout tối đa cho HTTP request (tính bằng milliseconds, 15000 = 15s)
VITE_API_TIMEOUT=15000

# Địa chỉ Backend trực tiếp & WebSocket Hubs (SignalR cho Chat & Thông báo)
VITE_BACKEND_URL=http://localhost:5226
VITE_WS_CHAT_URL=http://localhost:5226/hubs/chat
VITE_WS_NOTIF_URL=http://localhost:5226/hubs/notifications
VITE_WS_APP_URL=http://localhost:5226/hubs/app

# Cờ tính năng (Feature Flags)
# Cho phép chuyển sang dữ liệu mẫu Mock khi Backend chưa khởi chạy
VITE_ENABLE_MOCK=false
# Bật/Tắt tính năng Trợ lý AI tư vấn và gợi ý sách (AI Assistant)
VITE_ENABLE_AI_ASSISTANT=true

# -----------------------------------------------------------------------------
# 5. CỔNG THANH TOÁN TRỰC TUYẾN (PAYMENT GATEWAYS - SANDBOX)
# -----------------------------------------------------------------------------
# Cổng VNPAY Sandbox
VITE_VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VITE_VNPAY_TMN_CODE=BOOKVERSE01

# Cổng Ví MoMo Test Sandbox
VITE_MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
VITE_MOMO_PARTNER_CODE=MOMO_BOOKVERSE

# -----------------------------------------------------------------------------
# 6. ĐƠN VỊ VẬN CHUYỂN (GHN EXPRESS LOGISTICS - SANDBOX)
# -----------------------------------------------------------------------------
VITE_GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
VITE_GHN_SHOP_ID=190000
VITE_GHN_TOKEN=ghn-dev-token-example

# -----------------------------------------------------------------------------
# 7. LƯU TRỮ ẢNH & DỊCH VỤ XÁC THỰC BÊN THỨ 3 (CLOUDINARY & GOOGLE OAUTH)
# -----------------------------------------------------------------------------
# Cloudinary (Tải ảnh sản phẩm & banner trực tiếp từ client)
VITE_CLOUDINARY_CLOUD_NAME=bookverse-cloud
VITE_CLOUDINARY_UPLOAD_PRESET=bookverse_preset

# Google OAuth 2.0 Client ID (Lấy từ Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
